public class properhollow_triangle {

    static void main()
    {
        int n=5;
        //outer loop
        for(int row=1;row<=n;row++)
        {
        //space loop
            for(int col=1;col<=n-row;col++)
            {
                System.out.print(" ");
            }
            //part 1
            if(row==1||row==n) {
                for (int col = 1; col <= 2 * row - 1; col++)
                {
                    System.out.print("*");
                }
            }
            else
                {
                    //star
                    System.out.print("*");
                    //space
                    for(int col=1;col<=2*row-3;col++)
                    {
                        System.out.print(" ");
                    }
                    //star
                    System.out.print("*");
                }

            System.out.println();
        }

    }
}
