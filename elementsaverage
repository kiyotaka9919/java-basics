public class averagofelements {

    static void main() {

        int []arr={10,20,30,40,50};
        double avg=0.0;
        double sum =0;
        int c=0;
        for(int i=0;i<arr.length;i++)
        {
            c++;
            sum = sum+arr[i];
        }
        int len=arr.length;
        avg=sum/len;
        System.out.println("average of elements = "+avg);
    }
}
