public class hollowrightangle_trianglepattern {
    
    static void main()
    {
        int n=5;
        
        //outer loop
        for(int row=1;row<=n;row++)
        {
            for(int col=1;col<=row;col++)
            {
                if(row==3&&col==2)
                {
                    System.out.print("  ");
                }
                elseif((col==2||col==3)&&row==4)
                {
                    System.out.print("  ");
                }
                else
                {
                    System.out.print("* ");
                }
                
            }
            System.out.println();
        }
    }
}
