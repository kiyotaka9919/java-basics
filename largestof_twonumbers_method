public class Main {

    static void largest(int a, int b) {

        if (a > b) {
            System.out.println(a + " is largest");
        } else if (b > a) {
            System.out.println(b + " is largest");
        } else {
            System.out.println("Both are equal");
        }
    }

    public static void main(String[] args) {
        largest(50, 30);
    }
}
