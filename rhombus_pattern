public class rhombus_pattern {

    static void main()
    {
        int n=5;
        //outer loop
        for(int i=1;i<=n;i++)
        {
            //loop for space triangle
            for(int j=1;j<=n-i;j++)
            {
                System.out.print(" ");
            }
            //loop for rhombus
            for(int k=1;k<=n;k++)
            {
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
