public class reverse_trianglewithspace {

    static void main()
    {
        int n=4;
        //outer loop
        for(int i=1;i<=n;i++)
        {
            //space loope
            for(int j=1;j<=i-1;j++)
            {
                System.out.print(" ");
            }
            for(int k=1;k<=2*n-i-(i-1);k++)
            {
                System.out.print("*");
            }
System.out.println();
        }
    }
}
