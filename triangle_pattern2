public class InvertedPattern {
    public static void main(String[] args) {
        int rows = 5; // Change this value to adjust the size

        // Outer loop starts at maximum rows and counts down
        for (int i = rows; i >= 1; i--) {
            
            // Inner loop prints stars based on the current row count
            for (int j = 1; j <= i; j++) {
                System.out.print("* ");
            }
            
            // Move to the next line after completing a row
            System.out.println();
        }
    }
}
