//solid square pattern

public class pattern_1 {

    static void main()
    {

        int n=4;

        //outer loop for rows
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n;j++)
            {
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
