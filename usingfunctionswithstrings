public class functionswithstrings_prac {


   static String reverseStrings(String stri)
    {
        String reversed="";
        int len=stri.length();
        for(int i=len-1;i>=0;i--)
        {
            reversed=reversed+stri.charAt(i);
        }
        return reversed;
    }


    static boolean ispalindrome(String str)
    {
        String original=str;
        String reverse=reverseStrings(original);

        for(int i=0;i<=original.length()-1;i++)
        {
            char ch1=original.charAt(i);
            char ch2=reverse.charAt(i);
            if(ch1!=ch2)
            {
                return false;
            }
        }
        return true;

    }



    static void main() {

       String word="noon";
        System.out.println(ispalindrome(word));

    }
}
