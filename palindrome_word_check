public class plaindrome_words
{
    static void main() {
        String str="DAD";

        int len=str.length();
        String str1="";
        for(int i=len-1;i>=0;i--)
        {
            str1=str1+str.charAt(i);
        }
        if(str.equalsIgnoreCase(str1))
        {
            System.out.println("palindrome word");
        }
        else {
            System.out.println("it is not palindrome words");
        }
    }
}
