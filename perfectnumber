public class perfectnumber {


    static boolean isperfect(int n)
    {
        int j=0;
        j=n;
        int sum=0;
        for(int i=1;i<n;i++)
        {
            if(n%i==0)
            {
                sum =sum+i;
            }
        }
        if(sum==j)
        {
            return true;
        }
        else
        {
            return false;
        }
    }

    static void main() {

        boolean checkperfect=isperfect(6);
        System.out.println(checkperfect);
    }
}
