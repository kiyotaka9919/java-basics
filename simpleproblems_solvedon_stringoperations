public class printeach_character_of_a_string {

    public static void main(String[]args) {

        String str="i will get myself placed by mid of february ";

        //printing the charcters at each index
        int c=0;
        for(int i=0;i<str.length();i++)
        {
            System.out.println("character at index "+i+" = "+str.charAt(i));

        }

        //counting the vowels
        int count=0;
        for(int i=0;i<str.length();i++)
        {
            char ch1=str.charAt(i);
            if(ch1=='a'||ch1=='i'||ch1=='o'||ch1=='u'||ch1=='e') {
            count++;
        }

        }
        System.out.println("no of vowels in the given string = "+count++);

        //counting the length of string without using the length function
        char[]arr=str.toCharArray();
        for(char ch:arr)
        {
            c++;
        }
        System.out.println("length of string = "+c++);

        //reverse a string
        String str2="";
        int strlen=str.length();
        for(int i=strlen-1;i>=0;i--)
        {
            str2=str2+str.charAt(i);
        }
        System.out.print("reverse string is"+str2 );
    }
}
