import java.util.*;
public class sumtwodarray {


    static void main()
    {
        Scanner sc=new Scanner(System.in);
        int [][]arr=new int[3][3];
        int sum=0;
        int ans=1;
        for(int i=0;i<arr.length;i++)
        {
            for(int j=0;j<arr[i].length;j++)
            {
                System.out.println("enter element for row "+i+" "+"column "+j);
                arr[i][j]=sc.nextInt();
                sum=sum+arr[i][j];
                ans=ans*arr[i][j];

            }
        }
        int max =arr[0][0];
        for(int i=0;i<arr.length;i++)

        {
            for(int j=0;j<arr[i].length;j++)
            {
                if(arr[i][j]>max)
                {
                    max=arr[i][j];
                }
            }

        }
        System.out.println("largest element in the given array = "+max);
int sum1=0;
        for(int i=0;i<arr.length;i++)

        {
            for(int j=0;j<arr[i].length;j++)
            {
               sum1=sum1+arr[i][j];

            }
            System.out.println("sum of elements of row "+ (i+1) + " = "+sum1);
        }
int sum2=0;
        for(int i=0;i<arr.length;i++)

        {
            for(int j=0;j<arr[i].length;j++)
            {
           sum2=sum2+arr[j][i];

            }
            System.out.println("sum of elements of column "+(i+1)+" = "+sum2);

        }

        System.out.println("sum of elements = "+sum);
        System.out.println("product of elements = "+ans);

    }
}
