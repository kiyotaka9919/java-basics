import java.util.*;
public class sumtwodarray {


    static void main()
    {
        Scanner sc=new Scanner(System.in);
        int [][]arr=new int[3][3];
        int sum=0;
        int ans=1;
        for(int i=0;i<arr.length;i++)
        {
            for(int j=0;j<arr[i].length;j++)
            {
                System.out.println("enter element for row"+i+" "+"column"+j);
                arr[i][j]=sc.nextInt();
                sum=sum+arr[i][j];
                ans=ans*arr[i][j];

            }
        }
        

        System.out.println("sum of elements = "+sum);
        System.out.println("product of elements = "+ans);

    }
}
